# --- Privy authentication (required) ---
NEXT_PUBLIC_PRIVY_APP_ID=
# [server] Verifies Privy access tokens and resolves linked EVM wallets.
PRIVY_APP_SECRET=

# --- Database (required) ---
DATABASE_URL=
# [server] Optional. Direct (non-pooled) connection used only by
# npm run db:push / db:studio. Falls back to DATABASE_URL.
DIRECT_URL=

# --- Encryption keys (required, server) ---
# Two independent 32-byte keys (hex or base64), one per security domain:
# agent EVM private keys, and Lighter delegated API keys. Generate each
# separately for a new database and never reuse one for the other.
AGENT_WALLET_ENCRYPTION_KEY=
LIGHTER_API_KEY_ENCRYPTION_KEY=

# --- Robinhood Chain ---
# [public] "testnet" or "mainnet". Defaults to testnet when empty.
# Mainnet is deferred to Bang Rey; keep testnet.
NEXT_PUBLIC_ROBINHOOD_NETWORK=testnet
# [server] Optional dedicated RPC (may carry an API key). Empty uses the
# public RPC for the selected network. The browser always uses the public RPC.
ROBINHOOD_RPC_URL=

# --- GMGN discovery (required for discovery) ---
# [server] GMGN API key.
GMGN_API_KEY=
# [server] Comma-separated launchpad allow-list. No code default: discovery
# fails closed until set. Current reviewed value: pons. Do not add other
# labels without a separate reviewed decision.
GMGN_ROBINHOOD_LAUNCHPADS=pons

# --- AI provider: OpenRouter [server] ---
OPENROUTER_API_KEY=
# Optional model overrides for the large and small roles.
OPENROUTER_LARGE_MODEL=
OPENROUTER_SMALL_MODEL=

# --- Testnet canary (test tool only, not needed by the app) ---
# [server] Encrypts only the local testnet canary wallet file used by
# npm run canary:robinhood-testnet.
ROBINHOOD_TESTNET_CANARY_ENCRYPTION_KEY=
