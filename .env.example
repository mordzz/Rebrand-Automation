# --- Privy / Authentication ---
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only (PR09C): lets the backend verify Privy access tokens and
# resolve the user's linked EVM wallets with @privy-io/node before it
# creates an autonomous agent wallet. Without it, POST /api/my-bot and
# POST /api/my-bot/generate-wallet fail closed with 503.
PRIVY_APP_SECRET=
# PR17: comma-separated EVM (0x) wallets whose verified Privy owner may
# change HOUSE-level state (shared sniper config, house on/off, lesson
# apply, manual trade entry). Empty = nobody (fail closed).
HOUSE_ADMIN_WALLETS=
# Optional: defaults to NEXT_PUBLIC_PRIVY_APP_ID.
PRIVY_APP_ID=
# Optional: dashboard JWT verification key (SPKI PEM) to skip JWKS fetches.
PRIVY_JWT_VERIFICATION_KEY=

# --- Database ---
DATABASE_URL=
DIRECT_URL=
POSTGRES_URL=

# --- AI Provider ---
# Fill in exactly ONE provider.

OPENROUTER_API_KEY=
OPENROUTER_LARGE_MODEL=
OPENROUTER_SMALL_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# --- GMGN ---
GMGN_API_KEY=
# Comma-separated Robinhood launchpad allow-list for the production
# discovery adapter (lib/gmgn/discovery-robinhood.ts). No default is
# provided in code on purpose: discovery fails closed
# (returns launchpad_allowlist_not_configured) until this is set.
# Server-only — never expose via NEXT_PUBLIC_*.
#
# Current v1 verification target: pons.
#
# GMGN pons new_creation discovery and the required security fields have
# been live-verified.
#
# Do not interpret the GMGN "pons" label as proof of Pons V2 or of a
# Pump.fun-style bonding-curve lifecycle. Current sampled pons launches
# have real Uniswap V3 pools from creation, and the exact upstream
# launchpad contract/version mapping remains unresolved (see
# GMGN_ROBINHOOD_FIELD_MAP.md). Kept as the current operational choice
# because discovery works and security data is sufficient — not because
# Pump.fun lifecycle parity was proven.
#
# Do not add other launchpad labels (flap, flap_pve, flap_stocks,
# longxyz, trench, ...) without a separate reviewed decision.
GMGN_ROBINHOOD_LAUNCHPADS=pons

# --- Solana (historical read-only) ---
# Only used to display balances/market caps of HISTORICAL Solana bots and
# positions. No Solana transaction is ever built or signed.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Robinhood Chain ---
# "testnet" or "mainnet". Defaults to testnet if unset/empty; throws if
# set to anything else.
NEXT_PUBLIC_ROBINHOOD_NETWORK=testnet
# Robinhood's public RPCs are rate-limited and not for production use —
# set these to a dedicated provider (Alchemy/QuickNode/Chainstack/Dwellir)
# once you have one. Leave empty during local dev to use the public RPC
# for the selected network.
#
# ROBINHOOD_RPC_URL is server-side only (daemons, reconciliation,
# high-volume reads) and must never hold a value that's safe to ship to
# the browser bundle if it carries an API key.
ROBINHOOD_RPC_URL=
# NEXT_PUBLIC_ROBINHOOD_RPC_URL is inlined into the client bundle —
# only ever put a value here that's safe for every visitor to see.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# --- PR10 testnet canary (TEST ONLY) ---
# Encrypts ONLY the Robinhood testnet canary wallet file
# (npm run canary:robinhood-testnet). 32 bytes, hex or base64. Separate from
# AGENT_WALLET_ENCRYPTION_KEY on purpose. Never NEXT_PUBLIC_*.
ROBINHOOD_TESTNET_CANARY_ENCRYPTION_KEY=

# --- Lighter perps (PR12) ---
# Encrypts per-bot Lighter API private keys at rest (AES-256-GCM). 32 bytes,
# hex or base64. Server-only; read ONLY inside the Lighter signer worker.
# Separate from AGENT_WALLET_ENCRYPTION_KEY and the canary key on purpose.
# The official signer must be built once: npm run build:lighter-signer
LIGHTER_API_KEY_ENCRYPTION_KEY=

# --- Trading Safety ---
ELIZA_ENABLE_TRADING=false

# ==========================================
# DO NOT ENABLE YET
# ==========================================

AGENT_WALLET_ENCRYPTION_KEY=
