# Environment variables for Noah on Robinhood Chain.
# Copy to .env and fill in values. Never commit real values.
# [server] = server-only, never prefix with NEXT_PUBLIC_.
# [public] = inlined into the browser bundle, must be safe for every visitor.

# --- Privy authentication (required) ---
# [public] Privy app id.
NEXT_PUBLIC_PRIVY_APP_ID=
# [server] Verifies Privy access tokens and resolves linked EVM wallets.
# Without it, signed-in API routes fail closed with 503.
PRIVY_APP_SECRET=
# [server] Optional. Defaults to NEXT_PUBLIC_PRIVY_APP_ID.
PRIVY_APP_ID=
# [server] Optional. SPKI PEM verification key to skip JWKS fetches.
PRIVY_JWT_VERIFICATION_KEY=

# --- Database (required) ---
# [server] Postgres connection strings (pooled, direct, and fallback).
DATABASE_URL=
DIRECT_URL=
POSTGRES_URL=

# --- Encryption keys (required, server) ---
# 32 bytes, hex or base64. They decrypt existing database ciphertext:
# reuse the exact existing values for any deployment that shares the
# database. Never rotate or regenerate them.
AGENT_WALLET_ENCRYPTION_KEY=
LIGHTER_API_KEY_ENCRYPTION_KEY=

# --- Robinhood Chain ---
# [public] "testnet" or "mainnet". Defaults to testnet when empty.
# Mainnet is deferred to Bang Rey; keep testnet.
NEXT_PUBLIC_ROBINHOOD_NETWORK=
# [server] Optional dedicated RPC (may carry an API key). Empty uses the
# public RPC for the selected network.
ROBINHOOD_RPC_URL=
# [public] Optional browser RPC. Only a value safe for every visitor.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# --- GMGN discovery (required for discovery) ---
# [server] GMGN API key.
GMGN_API_KEY=
# [server] Comma-separated launchpad allow-list. No code default: discovery
# fails closed until set. Current reviewed value: pons. Do not add other
# labels without a separate reviewed decision.
GMGN_ROBINHOOD_LAUNCHPADS=

# --- AI provider (fill in exactly one) [server] ---
OPENROUTER_API_KEY=
OPENROUTER_LARGE_MODEL=
OPENROUTER_SMALL_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# --- Sniper config seed defaults (optional, server) ---
# Used only when seeding defaults; per-agent config overrides them.
# Names keep their historical _SOL suffix; values are in the bot's
# native unit. Leave empty to use code defaults.
SNIPER_ENABLED=
SNIPER_DRY_RUN=
SNIPER_ENTRY_SOURCES=
SNIPER_MIN_LIQUIDITY_SOL=
SNIPER_MAX_SOL_PER_SNIPE=
SNIPER_MAX_TOTAL_DEPLOYED_SOL=
SNIPER_MAX_DAILY_DRAWDOWN_SOL=
SNIPER_MAX_CONCURRENT_POSITIONS=
SNIPER_MAX_CONSECUTIVE_LOSSES=
SNIPER_MAX_CREATOR_BUY_PCT=
SNIPER_TAKE_PROFIT_PCT=
SNIPER_STOP_LOSS_PCT=
SNIPER_CRASH_DROP_PCT=
SNIPER_EXIT_CHECK_INTERVAL_MS=
SNIPER_METADATA_TIMEOUT_MS=

# --- Testnet canary (test only, not needed by the app) ---
# [server] Encrypts only the local testnet canary wallet file used by
# npm run canary:robinhood-testnet.
ROBINHOOD_TESTNET_CANARY_ENCRYPTION_KEY=
